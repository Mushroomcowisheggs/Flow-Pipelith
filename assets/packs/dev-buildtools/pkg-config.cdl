{
  "name": "pkg-config",
  "display_name": "pkg-config",
  "description": "Query installed libraries for their compile and link flags",
  "version": "0.29",
  "category": "development",
  "author": "pkg-config contributors",
  "license": "GPL-2.0",
  "homepage": "https://www.freedesktop.org/wiki/Software/pkg-config/",
  "tags": ["build", "dependencies", "libraries"],
  "platforms": ["windows", "linux", "macos"],
  "pipes": { "stdin": "none", "stdout": "capture", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["<package>"], "label": "package", "description": "A module name such as zlib, or several names separated by spaces", "takes": "text" },
    { "kind": "option", "tokens": ["--cflags"], "label": "--cflags", "description": "Print the compiler flags (include paths and defines) for the packages" },
    { "kind": "option", "tokens": ["--libs"], "label": "--libs", "description": "Print the linker flags (-L and -l) for the packages" },
    { "kind": "option", "tokens": ["--modversion"], "label": "--modversion", "description": "Print the version of each package" },
    { "kind": "option", "tokens": ["--exists"], "label": "--exists", "description": "Only test that the packages are installed; the exit code is the answer and nothing is printed" },
    { "kind": "option", "tokens": ["--atleast-version=<version>"], "label": "--atleast-version", "description": "Succeed only if the package version is at least this one", "takes": "text" },
    { "kind": "option", "tokens": ["--exact-version=<version>"], "label": "--exact-version", "description": "Succeed only if the package version is exactly this one", "takes": "text" },
    { "kind": "option", "tokens": ["--max-version=<version>"], "label": "--max-version", "description": "Succeed only if the package version is at most this one", "takes": "text" },
    { "kind": "option", "tokens": ["--variable=<name>"], "label": "--variable", "description": "Print one variable of the module, for example prefix, includedir, libdir", "takes": "text" },
    { "kind": "option", "tokens": ["--print-variables"], "label": "--print-variables", "description": "List the variable names the module defines" },
    { "kind": "option", "tokens": ["--static"], "label": "--static", "description": "Emit the flags for static linking" },
    { "kind": "option", "tokens": ["--libs-only-l"], "label": "--libs-only-l", "description": "Print only the -l flags" },
    { "kind": "option", "tokens": ["--libs-only-L"], "label": "--libs-only-L", "description": "Print only the -L flags" },
    { "kind": "option", "tokens": ["--cflags-only-I"], "label": "--cflags-only-I", "description": "Print only the -I include flags" },
    { "kind": "option", "tokens": ["--short-errors"], "label": "--short-errors", "description": "Print short error messages instead of the full ones" },
    { "kind": "option", "tokens": ["--validate"], "label": "--validate", "description": "Check that the .pc files are well formed" },
    { "kind": "note", "label": "The search path", "description": "pkg-config only finds modules whose .pc file is on its search path: set PKG_CONFIG_PATH to the directory holding the .pc file, for example a sysroot or a local install prefix" },
    { "kind": "note", "label": "One query per run", "description": "Pick a query option such as --cflags or --libs and give the module names after it; --exists prints nothing and answers with its exit code" },
    { "kind": "note", "label": "Quiet failures", "description": "Writing pkg-config --exists foo >/dev/null 2>&1 is the usual way to branch on a dependency in a script" }
  ]
}
