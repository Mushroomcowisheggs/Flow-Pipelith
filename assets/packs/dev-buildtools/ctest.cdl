{
  "name": "ctest",
  "display_name": "CTest",
  "description": "CMake's test driver: run, filter and report the project's tests",
  "version": "4.1",
  "category": "development",
  "author": "Kitware",
  "license": "BSD-3-Clause",
  "homepage": "https://cmake.org",
  "tags": ["build", "test", "cmake"],
  "platforms": ["windows", "linux", "macos"],
  "pipes": { "stdin": "none", "stdout": "capture", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["-R", "<regex>"], "label": "-R", "description": "Run only the tests whose name matches this regular expression", "takes": "text" },
    { "kind": "option", "tokens": ["-E", "<regex>"], "label": "-E", "description": "Skip the tests whose name matches this regular expression", "takes": "text" },
    { "kind": "option", "tokens": ["-L", "<regex>"], "label": "-L", "description": "Run only the tests whose labels match this regular expression", "takes": "text" },
    { "kind": "option", "tokens": ["-j", "<n>"], "label": "-j", "description": "Run this many tests in parallel (with no value: as many as there are cores)", "takes": "number" },
    { "kind": "option", "tokens": ["--test-dir", "<directory>"], "label": "--test-dir", "description": "Run the tests of the build tree in this directory", "takes": "directory" },
    { "kind": "option", "tokens": ["--output-on-failure"], "label": "--output-on-failure", "description": "Print the output of the tests that fail" },
    { "kind": "option", "tokens": ["--output-junit", "<file>"], "label": "--output-junit", "description": "Write the results to this JUnit XML file", "takes": "file" },
    { "kind": "option", "tokens": ["-V"], "label": "-V", "description": "Show every test's output as it runs" },
    { "kind": "option", "tokens": ["-VV"], "label": "-VV", "description": "Show even more: the command line and environment of each test" },
    { "kind": "option", "tokens": ["--verbose"], "label": "--verbose", "description": "The long spelling of -V" },
    { "kind": "option", "tokens": ["-N"], "label": "-N", "description": "List the tests without running any of them" },
    { "kind": "option", "tokens": ["--repeat", "<mode>"], "label": "--repeat", "description": "Repeat the run: until-fail, until-pass or after-timeout, with a count", "takes": "text" },
    { "kind": "option", "tokens": ["--timeout", "<seconds>"], "label": "--timeout", "description": "Fail a test that runs longer than this many seconds", "takes": "number" },
    { "kind": "option", "tokens": ["--stop-on-failure"], "label": "--stop-on-failure", "description": "Stop the run at the first failing test" },
    { "kind": "option", "tokens": ["--schedule-random"], "label": "--schedule-random", "description": "Run the tests in a random order to expose hidden ordering assumptions" },
    { "kind": "option", "tokens": ["-T", "test"], "label": "-T test", "description": "Run CTest in script mode: execute a CTest script's test step" },
    { "kind": "note", "label": "Where to run it", "description": "ctest runs the tests of the build tree it is started in: it reads CTestTestfile.cmake from the working directory, so either cd into the build directory or pass --test-dir <build dir>" },
    { "kind": "note", "label": "Build before testing", "description": "ctest does not rebuild anything; run the build (cmake --build or ninja/make) before ctest, or use ctest --build-and-test for the combined flow" },
    { "kind": "note", "label": "Read the log", "description": "Every run also writes Testing/Temporary/LastTest.log inside the build tree, which is the place to look when a test fails without visible output" }
  ]
}
