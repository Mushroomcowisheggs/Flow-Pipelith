{
  "name": "gcc-ar",
  "display_name": "gcc-ar",
  "description": "ar wrapper that loads the gcc plugin so archives with LTO objects keep their symbol index",
  "version": "14.2",
  "category": "development",
  "author": "GNU Project",
  "license": "GPL-3.0",
  "homepage": "https://gcc.gnu.org/onlinedocs/gcc/Arithmetic.html",
  "tags": ["gcc", "archive", "lto"],
  "platforms": ["windows", "linux", "macos"],
  "pipes": { "stdin": "none", "stdout": "capture", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["rcs", "<archive>"], "label": "rcs", "description": "Create the archive if needed, insert the members and write an index", "takes": "file" },
    { "kind": "option", "tokens": ["<member>"], "label": "member", "description": "A file to insert into the archive or to extract from it", "takes": "file" },
    { "kind": "option", "tokens": ["t", "<archive>"], "label": "t", "description": "List the members of the archive", "takes": "file" },
    { "kind": "option", "tokens": ["x", "<archive>"], "label": "x", "description": "Extract the members into the current directory", "takes": "file" },
    { "kind": "option", "tokens": ["d", "<archive>"], "label": "d", "description": "Delete the named members from the archive", "takes": "file" },
    { "kind": "option", "tokens": ["--plugin", "<plugin>"], "label": "--plugin", "description": "Load this plugin; gcc-ar passes the LTO plugin for you", "takes": "file" },
    { "kind": "note", "label": "Why it exists", "description": "gcc-ar is ar with the gcc LTO plugin loaded automatically, so an index over LTO objects is built with the right plugin; plain ar may produce an archive whose LTO members cannot be found" },
    { "kind": "note", "label": "It takes ar arguments", "description": "The whole ar command line is accepted unchanged: operations, modifiers and member names, for example gcc-ar rcs libfoo.a foo.o bar.o" }
  ]
}
