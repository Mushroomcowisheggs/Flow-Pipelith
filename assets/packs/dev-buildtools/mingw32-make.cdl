{
  "name": "mingw32-make",
  "display_name": "MinGW Make",
  "description": "GNU make under its MinGW name: build a project with a Makefile on Windows",
  "version": "4.4",
  "category": "development",
  "author": "GNU Project",
  "license": "GPL-3.0",
  "homepage": "https://www.gnu.org/software/make/",
  "tags": ["build", "mingw", "makefile"],
  "platforms": ["windows", "linux", "macos"],
  "pipes": { "stdin": "none", "stdout": "capture", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["<target>"], "label": "target", "description": "Build this target; with no target, the first one in the Makefile is built", "takes": "text" },
    { "kind": "option", "tokens": ["-f", "<makefile>"], "label": "-f", "description": "Read this makefile instead of Makefile", "takes": "file" },
    { "kind": "option", "tokens": ["-C", "<directory>"], "label": "-C", "description": "Change into this directory before reading the makefile", "takes": "directory" },
    { "kind": "option", "tokens": ["-j", "<n>"], "label": "-j", "description": "Run this many recipes in parallel (with no value: as many as possible)", "takes": "number" },
    { "kind": "option", "tokens": ["-k"], "label": "-k", "description": "Keep going after an error, as far as the dependencies allow" },
    { "kind": "option", "tokens": ["-B"], "label": "-B", "description": "Unconditionally make every target, as if none were up to date" },
    { "kind": "option", "tokens": ["-n"], "label": "-n", "description": "Dry run: print the recipes without executing them" },
    { "kind": "option", "tokens": ["-s"], "label": "-s", "description": "Silent: do not print the recipes as they are executed" },
    { "kind": "option", "tokens": ["-i"], "label": "-i", "description": "Ignore the errors of every recipe" },
    { "kind": "option", "tokens": ["-w"], "label": "-w", "description": "Print the working directory before and after the other output" },
    { "kind": "option", "tokens": ["-d"], "label": "-d", "description": "Print a large amount of debugging information" },
    { "kind": "option", "tokens": ["-p"], "label": "-p", "description": "Print the internal database of rules and variables" },
    { "kind": "option", "tokens": ["-e"], "label": "-e", "description": "Let environment variables override the makefile's assignments" },
    { "kind": "option", "tokens": ["-l", "<n>"], "label": "-l", "description": "Do not start new jobs while the load average is above this", "takes": "number" },
    { "kind": "option", "tokens": ["--version"], "label": "--version", "description": "Print the make version" },
    { "kind": "note", "label": "It is GNU make", "description": "mingw32-make is GNU make renamed by the MinGW distribution, so the whole GNU make manual applies: options use a single dash, for example -j8 or -f app.mak" },
    { "kind": "note", "label": "-C instead of cd", "description": "-C changes into the directory before the makefile is read, which is the reliable way to build a tree from somewhere else; repeat the flag to enter several directories" },
    { "kind": "note", "label": "Macros on the command line", "description": "A name=value argument sets a make variable, for example mingw32-make -j8 CONFIG=release; it goes after the options and before the targets" }
  ]
}
