{
  "name": "ninja",
  "display_name": "Ninja",
  "description": "Small, fast build executor that reads build.ninja",
  "version": "1.13",
  "category": "development",
  "author": "Ninja contributors",
  "license": "Apache-2.0",
  "homepage": "https://ninja-build.org",
  "tags": ["build", "build system"],
  "platforms": ["windows", "linux", "macos"],
  "pipes": { "stdin": "none", "stdout": "capture", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["<target>"], "label": "target", "description": "Build this target instead of the default one", "takes": "text" },
    { "kind": "option", "tokens": ["-j", "<n>"], "label": "-j", "description": "Run this many jobs in parallel", "takes": "number" },
    { "kind": "option", "tokens": ["-C", "<directory>"], "label": "-C", "description": "Change into this directory before building", "takes": "directory" },
    { "kind": "option", "tokens": ["-f", "<buildfile>"], "label": "-f", "description": "Read this build file instead of build.ninja", "takes": "file" },
    { "kind": "option", "tokens": ["-k", "<n>"], "label": "-k", "description": "Keep going until this many jobs failed (0 = never stop)", "takes": "number" },
    { "kind": "option", "tokens": ["-l", "<n>"], "label": "-l", "description": "Do not start new jobs while the load average is above this", "takes": "number" },
    { "kind": "option", "tokens": ["-n"], "label": "-n", "description": "Dry run: print the commands without running them" },
    { "kind": "option", "tokens": ["-v"], "label": "-v", "description": "Print the full command line of every edge" },
    { "kind": "option", "tokens": ["-d", "<mode>"], "label": "-d", "description": "Turn on one debugging mode (for example explain, stats, keeprsp)", "takes": "enum", "options": ["explain", "stats", "keeprsp", "list", "graph"] },
    { "kind": "option", "tokens": ["-t", "targets"], "label": "-t targets", "description": "List the targets of the build graph", "takes": "text" },
    { "kind": "option", "tokens": ["-t", "commands"], "label": "-t commands", "description": "List the commands needed to rebuild a target", "takes": "text" },
    { "kind": "option", "tokens": ["-t", "clean"], "label": "-t clean", "description": "Remove built files (with no target: everything ninja knows about)" },
    { "kind": "option", "tokens": ["-t", "compdb"], "label": "-t compdb", "description": "Print a compilation database for this rule or tool", "takes": "text" },
    { "kind": "option", "tokens": ["-t", "graph"], "label": "-t graph", "description": "Print the dependency graph in Graphviz dot format" },
    { "kind": "option", "tokens": ["-t", "browse"], "label": "-t browse", "description": "Browse the dependency graph in a browser" },
    { "kind": "option", "tokens": ["--version"], "label": "--version", "description": "Print the ninja version" },
    { "kind": "note", "label": "-C changes directory", "description": "ninja reads build.ninja from the working directory, so either run it in the build directory or pass -C, which changes into the directory first and reports paths relative to it" },
    { "kind": "note", "label": "Targets come last", "description": "Give options and tools before the target names: ninja -j 8 -t commands mylib, not ninja mylib -j 8" },
    { "kind": "note", "label": "Tool output can be long", "description": "ninja -t targets all and -t compdb print thousands of lines; capture the output to a file instead of reading it in the panel" }
  ]
}
