{
  "name": "g++",
  "display_name": "G++",
  "description": "GNU C++ compiler driver: compiles and links C++ source files",
  "category": "development",
  "author": "GNU Project",
  "license": "GPL-3.0",
  "homepage": "https://gcc.gnu.org",
  "tags": ["compiler", "C++", "GCC"],
  "platforms": ["windows", "macos", "linux"],
  "pipes": { "stdin": "none", "stdout": "capture", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["-std=<standard>"], "label": "-std", "description": "Select the C++ language standard", "takes": "enum", "options": ["c++11", "c++14", "c++17", "c++20", "c++23", "gnu++17", "gnu++20"] },
    { "kind": "option", "tokens": ["<level>"], "label": "Optimization level", "description": "-O0 disables optimization, -O2 is the usual release level, -Os optimizes for size", "takes": "enum", "options": ["-O0", "-O1", "-O2", "-O3", "-Os"] },
    { "kind": "option", "tokens": ["-Wall"], "label": "-Wall", "description": "Enable the common warning set" },
    { "kind": "option", "tokens": ["-Wextra"], "label": "-Wextra", "description": "Enable extra warnings beyond -Wall" },
    { "kind": "option", "tokens": ["-Werror"], "label": "-Werror", "description": "Treat every warning as an error" },
    { "kind": "option", "tokens": ["-g"], "label": "-g", "description": "Emit debug information for a debugger" },
    { "kind": "option", "tokens": ["-I", "<directory>"], "label": "-I", "description": "Add this directory to the header search path", "takes": "directory" },
    { "kind": "option", "tokens": ["-L", "<directory>"], "label": "-L", "description": "Add this directory to the library search path", "takes": "directory" },
    { "kind": "option", "tokens": ["-l", "<library>"], "label": "-l", "description": "Link this library, named without the lib prefix and the extension", "takes": "text" },
    { "kind": "option", "tokens": ["-o", "<file>"], "label": "-o", "description": "Write the output to this file instead of the default name", "takes": "file" },
    { "kind": "option", "tokens": ["-c"], "label": "-c", "description": "Compile and assemble only; do not link, so the result is an object file" },
    { "kind": "option", "tokens": ["-S"], "label": "-S", "description": "Stop after compilation and write assembly source" },
    { "kind": "option", "tokens": ["-E"], "label": "-E", "description": "Stop after preprocessing and write the preprocessed source" },
    { "kind": "option", "tokens": ["-shared"], "label": "-shared", "description": "Build a shared library instead of an executable" },
    { "kind": "option", "tokens": ["-fPIC"], "label": "-fPIC", "description": "Generate position-independent code, needed by most shared libraries" },
    { "kind": "option", "tokens": ["-pthread"], "label": "-pthread", "description": "Add the threading flags for compilation and linking" },
    { "kind": "option", "tokens": ["-march=<cpu>"], "label": "-march", "description": "Target this CPU, for example native or x86-64-v3", "takes": "text" },
    { "kind": "option", "tokens": ["-D<macro>"], "label": "-D", "description": "Define a preprocessor macro, written as NAME or NAME=value", "takes": "text" },
    { "kind": "note", "label": "g++ vs gcc", "description": "g++ compiles C++ and links the C++ standard library; gcc is the C driver" },
    { "kind": "note", "label": "Optimization levels", "description": "-O2 favors speed and -Os favors size; none of them implies -g, and debug information is added only by -g" },
    { "kind": "note", "label": "Library order", "description": "Object files and -l libraries are processed in the order given; a library must come after the objects that use it" }
  ]
}
