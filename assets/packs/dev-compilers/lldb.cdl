{
  "name": "lldb",
  "display_name": "LLDB",
  "description": "LLVM debugger: runs a program under a debugger, sets breakpoints and inspects state",
  "category": "development",
  "author": "LLVM Project",
  "license": "Apache-2.0 WITH LLVM-exception",
  "homepage": "https://lldb.llvm.org",
  "tags": ["debugger", "inspection", "LLVM"],
  "platforms": ["windows", "macos", "linux"],
  "pipes": { "stdin": "none", "stdout": "pipe", "stderr": "capture" },
  "permissions": ["filesystem", "process"],
  "vocabulary": [
    { "kind": "option", "tokens": ["-b"], "label": "-b", "description": "Run the batch commands and then quit instead of entering the interactive prompt (--batch)" },
    { "kind": "option", "tokens": ["-o", "<command>"], "label": "-o", "description": "Run one lldb command before the program is loaded; repeat for every command (--one-line)", "takes": "text" },
    { "kind": "option", "tokens": ["-s", "<file>"], "label": "-s", "description": "Read and run the lldb commands in this file (--source)", "takes": "file" },
    { "kind": "option", "tokens": ["-p", "<pid>"], "label": "-p", "description": "Attach to the running process with this process id (--attach-pid)", "takes": "number" },
    { "kind": "option", "tokens": ["-c", "<file>"], "label": "-c", "description": "Inspect this core dump instead of starting a program (--core)", "takes": "file" },
    { "kind": "option", "tokens": ["-a", "<arch>"], "label": "-a", "description": "Debug for this architecture (--arch)", "takes": "text" },
    { "kind": "subcommand", "tokens": ["run"], "label": "run", "description": "Start the program under the debugger" },
    { "kind": "subcommand", "tokens": ["b", "<location>"], "label": "b", "description": "Set a breakpoint from a location: a function name, a file:line pair or an address", "takes": "text" },
    { "kind": "subcommand", "tokens": ["breakpoint", "set", "--name", "<name>"], "label": "breakpoint set --name", "description": "Set a breakpoint on a function or symbol name", "takes": "text" },
    { "kind": "subcommand", "tokens": ["bt"], "label": "bt", "description": "Print the call stack of the current frame" },
    { "kind": "subcommand", "tokens": ["frame", "variable"], "label": "frame variable", "description": "Print the arguments and local variables of the current frame" },
    { "kind": "subcommand", "tokens": ["expression", "<expression>"], "label": "expression", "description": "Evaluate an expression and print its value; p is the short form", "takes": "text" },
    { "kind": "subcommand", "tokens": ["next"], "label": "next", "description": "Run to the next source line, stepping over calls" },
    { "kind": "subcommand", "tokens": ["step"], "label": "step", "description": "Run to the next source line, stepping into calls" },
    { "kind": "subcommand", "tokens": ["finish"], "label": "finish", "description": "Run until the current function returns" },
    { "kind": "subcommand", "tokens": ["continue"], "label": "continue", "description": "Resume the program until the next breakpoint" },
    { "kind": "subcommand", "tokens": ["quit"], "label": "quit", "description": "Leave the debugger" },
    { "kind": "note", "label": "Batch mode", "description": "lldb -b -o run -o bt ./prog runs the program, prints a backtrace and exits without a prompt" },
    { "kind": "note", "label": "Executable is an argument", "description": "Put the program after the options, as in lldb ./prog; the program's own arguments come after it" },
    { "kind": "note", "label": "Commands differ from gdb", "description": "The stack is bt, the locals are frame variable, an expression is expression or p, and breakpoints are set with b or breakpoint set" }
  ]
}
